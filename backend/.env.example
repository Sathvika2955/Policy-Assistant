# Copy to .env  (optional in development, required in production)
# Generate a key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Free key from https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=
# If you hit rate limits (429), try: gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
